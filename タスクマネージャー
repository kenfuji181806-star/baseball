<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HabitQuest</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0a0a0f;
  --surface: #13131a;
  --surface2: #1c1c27;
  --surface3: #252535;
  --accent: #7c6af7;
  --accent2: #a78bfa;
  --gold: #f5c842;
  --green: #22d3a0;
  --red: #f87171;
  --text: #f0f0ff;
  --muted: #6b6b8a;
  --border: rgba(255,255,255,0.07);
  --r: 14px;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse 80% 50% at 50% -10%,rgba(124,106,247,0.15),transparent);pointer-events:none;z-index:0}

/* HEADER */
header{position:sticky;top:0;z-index:50;background:rgba(10,10,15,0.85);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:0 1.5rem}
.header-inner{max-width:960px;margin:0 auto;height:60px;display:flex;align-items:center;gap:1rem}
.logo{font-family:'Syne',sans-serif;font-weight:800;font-size:1.3rem;letter-spacing:-0.02em;background:linear-gradient(135deg,var(--accent2),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.header-stats{margin-left:auto;display:flex;gap:1rem;align-items:center}
.hstat{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--muted)}
.hstat .val{font-family:'Syne',sans-serif;font-weight:700;color:var(--text);font-size:14px}
.hstat .icon{font-size:16px}

/* LAYOUT */
.container{max-width:960px;margin:0 auto;padding:2rem 1.5rem;position:relative;z-index:1}
.grid{display:grid;grid-template-columns:1fr 320px;gap:1.5rem;align-items:start}

/* LEVEL CARD */
.level-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:1.5rem;margin-bottom:1.5rem;position:relative;overflow:hidden}
.level-card::before{content:'';position:absolute;top:-40px;right:-40px;width:160px;height:160px;background:radial-gradient(circle,rgba(124,106,247,0.2),transparent 70%);pointer-events:none}
.level-row{display:flex;align-items:center;gap:1rem;margin-bottom:1rem}
.level-badge{width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent2));display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-weight:800;font-size:1.3rem;flex-shrink:0;box-shadow:0 0 24px rgba(124,106,247,0.4)}
.level-info{flex:1}
.level-title{font-family:'Syne',sans-serif;font-weight:700;font-size:1rem;margin-bottom:2px}
.level-sub{font-size:12px;color:var(--muted)}
.xp-bar-wrap{position:relative;height:8px;background:var(--surface3);border-radius:4px;overflow:hidden}
.xp-bar{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:4px;transition:width 0.6s cubic-bezier(.34,1.56,.64,1)}
.xp-label{font-size:11px;color:var(--muted);margin-top:4px;text-align:right}

/* STREAK BANNER */
.streak-banner{background:linear-gradient(135deg,rgba(245,200,66,0.12),rgba(245,200,66,0.04));border:1px solid rgba(245,200,66,0.25);border-radius:var(--r);padding:1rem 1.25rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:1rem}
.streak-fire{font-size:2rem;line-height:1}
.streak-num{font-family:'Syne',sans-serif;font-weight:800;font-size:2rem;color:var(--gold);line-height:1}
.streak-text{font-size:12px;color:var(--muted);margin-top:2px}
.streak-calendar{margin-left:auto;display:flex;gap:4px}
.streak-dot{width:10px;height:10px;border-radius:50%;background:var(--surface3)}
.streak-dot.done{background:var(--gold)}
.streak-dot.today{background:var(--gold);box-shadow:0 0 6px var(--gold)}

/* SECTION */
.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem}
.section-title{font-family:'Syne',sans-serif;font-weight:700;font-size:0.95rem;letter-spacing:0.05em;text-transform:uppercase;color:var(--muted)}
.btn-add{background:var(--accent);color:#fff;border:none;border-radius:8px;padding:6px 14px;font-size:12px;font-family:'Syne',sans-serif;font-weight:700;cursor:pointer;transition:all 0.15s;letter-spacing:0.03em}
.btn-add:hover{background:var(--accent2);transform:translateY(-1px)}

/* HABIT LIST */
.habits-list{display:flex;flex-direction:column;gap:8px;margin-bottom:2rem}
.habit-item{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px 16px;display:flex;align-items:center;gap:12px;cursor:pointer;transition:all 0.2s;user-select:none;position:relative;overflow:hidden}
.habit-item::after{content:'';position:absolute;inset:0;background:var(--accent);opacity:0;transition:opacity 0.2s}
.habit-item:hover{border-color:rgba(124,106,247,0.3);transform:translateX(2px)}
.habit-check{width:28px;height:28px;border-radius:50%;border:2px solid var(--surface3);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all 0.2s;font-size:14px;background:var(--surface2)}
.habit-item.checked .habit-check{background:var(--green);border-color:var(--green);color:#fff;box-shadow:0 0 12px rgba(34,211,160,0.4)}
.habit-item.checked{opacity:0.6}
.habit-name{flex:1;font-size:14px;font-weight:500}
.habit-streak{display:flex;align-items:center;gap:4px;font-size:12px;font-family:'Syne',sans-serif;font-weight:700;color:var(--gold)}
.habit-xp{font-size:11px;color:var(--muted);background:var(--surface2);padding:2px 8px;border-radius:6px}
.habit-emoji{font-size:20px;width:32px;text-align:center;flex-shrink:0}

/* TODO LIST */
.todo-list{display:flex;flex-direction:column;gap:8px;margin-bottom:2rem}
.todo-item{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:12px 16px;display:flex;align-items:center;gap:10px;transition:all 0.2s}
.todo-item:hover{border-color:rgba(124,106,247,0.25)}
.todo-check{width:22px;height:22px;border-radius:6px;border:1.5px solid var(--surface3);cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:var(--surface2);transition:all 0.2s;font-size:12px}
.todo-item.checked .todo-check{background:var(--accent);border-color:var(--accent);color:#fff}
.todo-item.checked .todo-name{text-decoration:line-through;color:var(--muted)}
.todo-name{flex:1;font-size:14px}
.todo-pri{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.pri-high{background:var(--red)}
.pri-med{background:var(--gold)}
.pri-low{background:var(--green)}
.todo-del{background:none;border:none;cursor:pointer;color:var(--muted);font-size:16px;padding:2px 6px;border-radius:4px;opacity:0;transition:opacity 0.2s}
.todo-item:hover .todo-del{opacity:1}
.todo-del:hover{color:var(--red);background:rgba(248,113,113,0.1)}

/* RIGHT PANEL */
.panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:1.25rem;margin-bottom:1.25rem}
.panel-title{font-family:'Syne',sans-serif;font-weight:700;font-size:0.8rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted);margin-bottom:1rem}

/* WEEKLY HEAT */
.week-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.day-label{font-size:10px;color:var(--muted);text-align:center;margin-bottom:4px}
.day-cell{aspect-ratio:1;border-radius:4px;background:var(--surface3)}
.day-cell.lvl1{background:rgba(124,106,247,0.3)}
.day-cell.lvl2{background:rgba(124,106,247,0.55)}
.day-cell.lvl3{background:rgba(124,106,247,0.8)}
.day-cell.lvl4{background:var(--accent);box-shadow:0 0 6px rgba(124,106,247,0.5)}

/* ACHIEVEMENT */
.achievement-list{display:flex;flex-direction:column;gap:8px}
.ach{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:8px;background:var(--surface2)}
.ach.locked{opacity:0.35}
.ach-icon{font-size:1.4rem;width:32px;text-align:center}
.ach-name{font-size:12px;font-weight:500}
.ach-desc{font-size:11px;color:var(--muted)}

/* TOAST */
.toast{position:fixed;bottom:2rem;right:2rem;background:var(--surface2);border:1px solid var(--accent);border-radius:var(--r);padding:12px 20px;font-size:13px;z-index:999;transform:translateY(100px);opacity:0;transition:all 0.4s cubic-bezier(.34,1.56,.64,1);pointer-events:none;max-width:280px}
.toast.show{transform:translateY(0);opacity:1;pointer-events:all}
.toast-title{font-family:'Syne',sans-serif;font-weight:700;font-size:14px;color:var(--accent2);margin-bottom:2px}
.toast-undo{margin-top:8px;background:rgba(124,106,247,0.2);border:1px solid var(--accent);color:var(--accent2);border-radius:6px;padding:4px 14px;font-size:12px;font-family:'Syne',sans-serif;font-weight:700;cursor:pointer;width:100%;transition:background 0.15s}
.toast-undo:hover{background:rgba(124,106,247,0.35)}

/* MODAL */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center;z-index:200;opacity:0;pointer-events:none;transition:opacity 0.2s}
.modal-bg.open{opacity:1;pointer-events:all}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:2rem;width:380px;transform:translateY(20px);transition:transform 0.3s cubic-bezier(.34,1.56,.64,1)}
.modal-bg.open .modal{transform:translateY(0)}
.modal h3{font-family:'Syne',sans-serif;font-weight:800;font-size:1.2rem;margin-bottom:1.25rem}
.field{margin-bottom:1rem}
.field label{font-size:12px;color:var(--muted);display:block;margin-bottom:4px;font-weight:500}
.field input,.field select{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;outline:none;transition:border-color 0.2s}
.field input:focus,.field select:focus{border-color:var(--accent)}
.emoji-row{display:flex;gap:8px;flex-wrap:wrap}
.emoji-opt{width:36px;height:36px;background:var(--surface2);border:1.5px solid transparent;border-radius:8px;cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center;transition:all 0.15s}
.emoji-opt.sel{border-color:var(--accent);background:rgba(124,106,247,0.15)}
.modal-btns{display:flex;gap:8px;margin-top:1.25rem;justify-content:flex-end}
.btn-cancel{background:transparent;border:1px solid var(--border);color:var(--muted);border-radius:8px;padding:8px 18px;cursor:pointer;font-size:13px;transition:all 0.15s}
.btn-cancel:hover{border-color:var(--muted)}
.btn-save{background:var(--accent);color:#fff;border:none;border-radius:8px;padding:8px 20px;cursor:pointer;font-family:'Syne',sans-serif;font-weight:700;font-size:13px;transition:all 0.15s}
.btn-save:hover{background:var(--accent2)}

/* REMINDER TOGGLE */
.reminder-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)}
.reminder-row:last-child{border-bottom:none}
.reminder-label{font-size:13px}
.reminder-time{font-size:12px;color:var(--muted)}
.toggle{width:38px;height:22px;background:var(--surface3);border-radius:11px;cursor:pointer;position:relative;transition:background 0.2s;flex-shrink:0}
.toggle.on{background:var(--accent)}
.toggle::after{content:'';position:absolute;width:16px;height:16px;border-radius:50%;background:#fff;top:3px;left:3px;transition:left 0.2s}
.toggle.on::after{left:19px}

/* CONFETTI */
.confetti-wrap{position:fixed;inset:0;pointer-events:none;z-index:998}

@media(max-width:700px){.grid{grid-template-columns:1fr}}

.toast-undo{margin-top:8px;background:rgba(124,106,247,0.2);border:1px solid var(--accent);color:var(--accent2);border-radius:6px;padding:4px 14px;font-size:12px;font-family:'Syne',sans-serif;font-weight:700;cursor:pointer;width:100%;transition:background 0.15s}
.toast-undo:hover{background:rgba(124,106,247,0.35)}

/* GITHUB SYNC */
.sync-panel{background:linear-gradient(135deg,rgba(124,106,247,0.08),rgba(34,211,160,0.05));border:1px solid rgba(124,106,247,0.2);border-radius:var(--r);padding:1.25rem;margin-bottom:1.25rem}
.sync-title{font-family:'Syne',sans-serif;font-weight:700;font-size:0.8rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted);margin-bottom:1rem;display:flex;align-items:center;gap:6px}
.sync-status{display:flex;align-items:center;gap:8px;font-size:12px;margin-bottom:12px;padding:8px 10px;border-radius:8px;background:var(--surface2)}
.sync-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.sync-dot.ok{background:var(--green);box-shadow:0 0 6px var(--green)}
.sync-dot.err{background:var(--red)}
.sync-dot.idle{background:var(--muted)}
.sync-dot.loading{background:var(--gold);animation:pulse 1s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.3}}
.sync-msg{color:var(--text);flex:1}
.sync-time{font-size:11px;color:var(--muted)}
.sync-row{display:flex;gap:6px;margin-bottom:8px}
.sync-input{flex:1;background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:8px 10px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:12px;outline:none}
.sync-input:focus{border-color:var(--accent)}
.sync-input::placeholder{color:var(--muted)}
.btn-sync{background:var(--accent);color:#fff;border:none;border-radius:8px;padding:8px 14px;font-size:12px;font-family:'Syne',sans-serif;font-weight:700;cursor:pointer;transition:all 0.15s;white-space:nowrap}
.btn-sync:hover{background:var(--accent2);transform:translateY(-1px)}
.btn-sync:disabled{opacity:0.5;cursor:not-allowed;transform:none}
.btn-sync-sm{background:transparent;border:1px solid var(--border);color:var(--muted);border-radius:6px;padding:5px 10px;font-size:11px;cursor:pointer;transition:all 0.15s}
.btn-sync-sm:hover{border-color:var(--accent);color:var(--accent2)}
.sync-btns{display:flex;gap:6px}
.sync-warn{font-size:11px;color:var(--muted);margin-top:6px;line-height:1.5}
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <div class="logo">HabitQuest</div>
    <div class="header-stats">
      <div class="hstat"><span class="icon">⚡</span><span class="val" id="h-xp">0</span><span>XP</span></div>
      <div class="hstat"><span class="icon">🔥</span><span class="val" id="h-streak">0</span><span>日</span></div>
      <div class="hstat"><span class="icon">✅</span><span class="val" id="h-done">0</span><span>/</span><span class="val" id="h-total">0</span></div>
    </div>
  </div>
</header>

<div class="container">
  <!-- Level Card -->
  <div class="level-card">
    <div class="level-row">
      <div class="level-badge" id="lv-badge">1</div>
      <div class="level-info">
        <div class="level-title" id="lv-title">見習い冒険者</div>
        <div class="level-sub" id="lv-next">次のレベルまで <span id="lv-xp-need">100</span> XP</div>
      </div>
    </div>
    <div class="xp-bar-wrap"><div class="xp-bar" id="xp-bar" style="width:0%"></div></div>
    <div class="xp-label"><span id="xp-cur">0</span> / <span id="xp-max">100</span> XP</div>
  </div>

  <!-- Streak Banner -->
  <div class="streak-banner">
    <div class="streak-fire">🔥</div>
    <div>
      <div style="display:flex;align-items:baseline;gap:8px">
        <div class="streak-num" id="streak-num">0</div>
        <div style="font-size:14px;font-weight:500">日連続達成！</div>
      </div>
      <div class="streak-text" id="streak-text">今日も習慣を完了してストリークを伸ばそう</div>
    </div>
    <div class="streak-calendar" id="streak-cal"></div>
  </div>

  <div class="grid">
    <div>
      <!-- Habits -->
      <div class="section-head">
        <div class="section-title">🌱 今日の習慣</div>
        <button class="btn-add" onclick="openHabitModal()">+ 追加</button>
      </div>
      <div class="habits-list" id="habits-list"></div>

      <!-- Todos -->
      <div class="section-head">
        <div class="section-title">📋 タスク</div>
        <button class="btn-add" onclick="openTodoModal()">+ 追加</button>
      </div>
      <div class="todo-list" id="todo-list"></div>
    </div>

    <div>
      <!-- Weekly Activity -->
      <div class="panel">
        <div class="panel-title">📊 今週の活動</div>
        <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-bottom:6px">
          <div style="font-size:10px;color:var(--muted);text-align:center">月</div>
          <div style="font-size:10px;color:var(--muted);text-align:center">火</div>
          <div style="font-size:10px;color:var(--muted);text-align:center">水</div>
          <div style="font-size:10px;color:var(--muted);text-align:center">木</div>
          <div style="font-size:10px;color:var(--muted);text-align:center">金</div>
          <div style="font-size:10px;color:var(--muted);text-align:center">土</div>
          <div style="font-size:10px;color:var(--muted);text-align:center">日</div>
        </div>
        <div class="week-grid" id="week-grid"></div>
        <div style="font-size:11px;color:var(--muted);margin-top:10px;text-align:right" id="week-summary"></div>
      </div>

      <!-- Achievements -->
      <div class="panel">
        <div class="panel-title">🏆 実績</div>
        <div class="achievement-list" id="ach-list"></div>
      </div>


      <!-- GitHub Sync -->
      <div class="sync-panel" id="sync-panel">
        <div class="sync-title">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" style="color:var(--accent2)"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          GitHub 同期
        </div>
        <div class="sync-status" id="sync-status">
          <div class="sync-dot idle" id="sync-dot"></div>
          <div class="sync-msg" id="sync-msg">未接続 — トークンを設定してください</div>
        </div>
        <div id="sync-config">
          <div class="sync-row">
            <input class="sync-input" id="gh-token" type="password" placeholder="Personal Access Token (repo権限)" autocomplete="off">
          </div>
          <div class="sync-row">
            <input class="sync-input" id="gh-owner" placeholder="ユーザー名 (例: kenfuji181806-star)" style="flex:1">
            <input class="sync-input" id="gh-repo" placeholder="リポジトリ名 (例: baseball)" style="flex:1">
          </div>
          <div class="sync-row">
            <input class="sync-input" id="gh-path" placeholder="ファイルパス (例: タスクマネージャー)" style="flex:1">
            <button class="btn-sync" onclick="saveGhConfig()">接続</button>
          </div>
          <div class="sync-warn">⚠️ 個人利用のみ。PATはlocalStorageに保存されます。</div>
        </div>
        <div id="sync-actions" style="display:none">
          <div class="sync-btns">
            <button class="btn-sync" onclick="ghPush()" id="btn-push">⬆ GitHubに保存</button>
            <button class="btn-sync-sm" onclick="ghPull()" id="btn-pull">⬇ 読み込む</button>
            <button class="btn-sync-sm" onclick="clearGhConfig()" style="margin-left:auto">設定解除</button>
          </div>
          <div style="font-size:11px;color:var(--muted);margin-top:8px" id="sync-last"></div>
        </div>
      </div>
      <!-- Reminders -->
      <div class="panel">
        <div class="panel-title">🔔 リマインダー</div>
        <div id="reminder-list"></div>
      </div>
    </div>
  </div>
</div>

<!-- Toast -->
<div class="toast" id="toast"><div class="toast-title" id="toast-title"></div><div id="toast-msg"></div><button class="toast-undo" id="toast-undo" style="display:none" onclick="undoLast()">↩ 取り消す</button></div>

<!-- Habit Modal -->
<div class="modal-bg" id="habit-modal">
  <div class="modal">
    <h3>習慣を追加</h3>
    <div class="field">
      <label>習慣名</label>
      <input id="h-name" placeholder="例: 朝のストレッチ" maxlength="30">
    </div>
    <div class="field">
      <label>アイコン</label>
      <div class="emoji-row" id="emoji-row"></div>
    </div>
    <div class="field">
      <label>難易度（XP）</label>
      <select id="h-diff">
        <option value="10">かんたん（10 XP）</option>
        <option value="20" selected>ふつう（20 XP）</option>
        <option value="40">むずかしい（40 XP）</option>
      </select>
    </div>
    <div class="modal-btns">
      <button class="btn-cancel" onclick="closeModal('habit-modal')">キャンセル</button>
      <button class="btn-save" onclick="addHabit()">追加</button>
    </div>
  </div>
</div>

<!-- Todo Modal -->
<div class="modal-bg" id="todo-modal">
  <div class="modal">
    <h3>タスクを追加</h3>
    <div class="field">
      <label>タスク名</label>
      <input id="t-name" placeholder="例: レポートを提出する" maxlength="40">
    </div>
    <div class="field">
      <label>優先度</label>
      <select id="t-pri">
        <option value="high">🔴 高</option>
        <option value="med" selected>🟡 中</option>
        <option value="low">🟢 低</option>
      </select>
    </div>
    <div class="modal-btns">
      <button class="btn-cancel" onclick="closeModal('todo-modal')">キャンセル</button>
      <button class="btn-save" onclick="addTodo()">追加</button>
    </div>
  </div>
</div>

<!-- Confetti -->
<canvas class="confetti-wrap" id="confetti-canvas"></canvas>

<script>
const EMOJIS=['🏃','📚','💪','🧘','✍️','🎯','🌿','💧','🎨','🎵','🍎','😴'];
const LEVELS=[
  {name:'見習い冒険者',xp:100},{name:'目覚めし者',xp:250},{name:'鍛錬の徒',xp:500},
  {name:'習慣の騎士',xp:900},{name:'継続の達人',xp:1400},{name:'伝説の旅人',xp:2200},
  {name:'意志の覇者',xp:9999}
];
const ACHIEVEMENTS=[
  {id:'first',icon:'🌟',name:'はじめの一歩',desc:'初めて習慣を完了',cond:s=>s.totalDone>=1},
  {id:'streak3',icon:'🔥',name:'3日連続',desc:'3日間ストリーク達成',cond:s=>s.streak>=3},
  {id:'streak7',icon:'⚡',name:'一週間の炎',desc:'7日間連続',cond:s=>s.streak>=7},
  {id:'streak30',icon:'💎',name:'鋼の意志',desc:'30日間連続',cond:s=>s.streak>=30},
  {id:'lv3',icon:'🏅',name:'レベル3達成',desc:'レベル3に到達',cond:s=>s.level>=3},
  {id:'lv5',icon:'🏆',name:'ベテラン',desc:'レベル5に到達',cond:s=>s.level>=5},
];

let state=loadState();
let selectedEmoji='🏃';

function loadState(){
  const d=localStorage.getItem('hq_state');
  if(d)return JSON.parse(d);
  return{
    xp:0,level:1,streak:0,lastDate:'',totalDone:0,
    habits:[
      {id:1,name:'朝のストレッチ',emoji:'🏃',xp:20,streak:0,lastDate:'',doneToday:false},
      {id:2,name:'10分読書',emoji:'📚',xp:20,streak:0,lastDate:'',doneToday:false},
      {id:3,name:'水を8杯飲む',emoji:'💧',xp:10,streak:0,lastDate:'',doneToday:false},
    ],
    todos:[
      {id:1,name:'アプリのアイデアをまとめる',pri:'high',done:false},
      {id:2,name:'今週の振り返りを書く',pri:'med',done:false},
    ],
    weekActivity:[0,0,0,0,0,0,0],
    unlockedAch:[],
    reminders:[
      {label:'朝の習慣チェック',time:'07:00',on:true},
      {label:'夜の振り返り',time:'21:00',on:false},
    ],
    nextHabitId:10,nextTodoId:10
  };
}
function saveState(){localStorage.setItem('hq_state',JSON.stringify(state))}

const today=new Date().toISOString().split('T')[0];
// Reset daily habits if new day
if(state.lastDate!==today){
  // Update streak
  const yesterday=new Date(Date.now()-86400000).toISOString().split('T')[0];
  const anyDoneYesterday=state.habits.some(h=>h.lastDate===yesterday);
  if(state.lastDate===yesterday&&anyDoneYesterday) state.streak++;
  else if(state.lastDate!==yesterday&&state.lastDate!=='') state.streak=0;
  state.habits.forEach(h=>{h.doneToday=false});
  const dow=(new Date().getDay()+6)%7;
  state.weekActivity=state.weekActivity||[0,0,0,0,0,0,0];
  state.lastDate=today;
  saveState();
}

function render(){
  renderHeader();renderLevel();renderStreak();renderHabits();renderTodos();renderWeek();renderAch();renderReminders();
}

function renderHeader(){
  const done=state.habits.filter(h=>h.doneToday).length+state.todos.filter(t=>t.done).length;
  const total=state.habits.length+state.todos.length;
  document.getElementById('h-xp').textContent=state.xp;
  document.getElementById('h-streak').textContent=state.streak;
  document.getElementById('h-done').textContent=done;
  document.getElementById('h-total').textContent=total;
}

function renderLevel(){
  let lv=0,cumulXp=0;
  for(let i=0;i<LEVELS.length;i++){
    if(state.xp>=cumulXp+LEVELS[i].xp){cumulXp+=LEVELS[i].xp;lv++;}
    else{
      const pct=Math.round((state.xp-cumulXp)/LEVELS[i].xp*100);
      state.level=lv+1;
      document.getElementById('lv-badge').textContent=lv+1;
      document.getElementById('lv-title').textContent=LEVELS[lv].name;
      document.getElementById('lv-xp-need').textContent=LEVELS[lv].xp-(state.xp-cumulXp);
      document.getElementById('xp-bar').style.width=pct+'%';
      document.getElementById('xp-cur').textContent=state.xp-cumulXp;
      document.getElementById('xp-max').textContent=LEVELS[lv].xp;
      return;
    }
  }
  document.getElementById('lv-badge').textContent=LEVELS.length;
  document.getElementById('lv-title').textContent='LEGEND';
  document.getElementById('xp-bar').style.width='100%';
}

function renderStreak(){
  document.getElementById('streak-num').textContent=state.streak;
  const txt=state.streak===0?'今日も習慣を完了してストリークを伸ばそう':`${state.streak}日間継続中！すばらしい！`;
  document.getElementById('streak-text').textContent=txt;
  const cal=document.getElementById('streak-cal');
  cal.innerHTML='';
  for(let i=6;i>=0;i--){
    const d=document.createElement('div');
    d.className='streak-dot';
    if(i===0)d.classList.add('today');
    else if(i<=state.streak)d.classList.add('done');
    cal.appendChild(d);
  }
}

function renderHabits(){
  const el=document.getElementById('habits-list');
  if(!state.habits.length){el.innerHTML='<div style="text-align:center;padding:1.5rem;color:var(--muted);font-size:13px">習慣がまだありません。追加してみましょう！</div>';return;}
  el.innerHTML=state.habits.map(h=>`
    <div class="habit-item${h.doneToday?' checked':''}" onclick="toggleHabit(${h.id})">
      <div class="habit-emoji">${h.emoji}</div>
      <div class="habit-check">${h.doneToday?'✓':''}</div>
      <div class="habit-name">${h.name}</div>
      ${h.streak>0?`<div class="habit-streak">🔥${h.streak}</div>`:''}
      <div class="habit-xp">+${h.xp} XP</div>
      <button onclick="event.stopPropagation();deleteHabit(${h.id})" style="background:none;border:none;cursor:pointer;color:var(--muted);padding:4px;border-radius:4px;font-size:14px;opacity:0.5;transition:opacity 0.2s" onmouseover="this.style.opacity=1;this.style.color='var(--red)'" onmouseout="this.style.opacity=0.5;this.style.color='var(--muted)'">✕</button>
    </div>`).join('');
}

function renderTodos(){
  const el=document.getElementById('todo-list');
  if(!state.todos.length){el.innerHTML='<div style="text-align:center;padding:1.5rem;color:var(--muted);font-size:13px">タスクがありません。</div>';return;}
  el.innerHTML=state.todos.map(t=>`
    <div class="todo-item${t.done?' checked':''}">
      <div class="todo-pri pri-${t.pri}"></div>
      <div class="todo-check" onclick="toggleTodo(${t.id})">${t.done?'✓':''}</div>
      <div class="todo-name">${t.name}</div>
      <button class="todo-del" onclick="deleteTodo(${t.id})">✕</button>
    </div>`).join('');
}

function renderWeek(){
  const grid=document.getElementById('week-grid');
  grid.innerHTML='';
  const max=Math.max(...state.weekActivity,1);
  state.weekActivity.forEach(v=>{
    const d=document.createElement('div');
    d.className='day-cell';
    const r=v/max;
    if(r>0.75)d.classList.add('lvl4');
    else if(r>0.5)d.classList.add('lvl3');
    else if(r>0.25)d.classList.add('lvl2');
    else if(r>0)d.classList.add('lvl1');
    grid.appendChild(d);
  });
  const total=state.weekActivity.reduce((a,b)=>a+b,0);
  document.getElementById('week-summary').textContent=`今週 ${total} 個完了`;
}

function renderAch(){
  const el=document.getElementById('ach-list');
  el.innerHTML=ACHIEVEMENTS.map(a=>{
    const unlocked=state.unlockedAch.includes(a.id);
    return`<div class="ach${unlocked?'':' locked'}">
      <div class="ach-icon">${a.icon}</div>
      <div><div class="ach-name">${a.name}</div><div class="ach-desc">${a.desc}</div></div>
    </div>`;
  }).join('');
}

function renderReminders(){
  const el=document.getElementById('reminder-list');
  el.innerHTML=state.reminders.map((r,i)=>`
    <div class="reminder-row">
      <div><div class="reminder-label">${r.label}</div><div class="reminder-time">${r.time}</div></div>
      <div class="toggle${r.on?' on':''}" onclick="toggleReminder(${i})"></div>
    </div>`).join('');
}

function toggleHabit(id){
  const h=state.habits.find(x=>x.id===id);
  if(!h)return;
  if(h.doneToday){
    h.doneToday=false;h.lastDate='';h.streak=Math.max(0,h.streak-1);
    state.xp=Math.max(0,state.xp-h.xp);state.totalDone=Math.max(0,state.totalDone-1);
    const u=(new Date().getDay()+6)%7;state.weekActivity[u]=Math.max(0,(state.weekActivity[u]||0)-1);
    saveState();showToast('취 소','習慣の完了を元に戻しました',false);render();return;
  }
  h.doneToday=true;
  h.lastDate=today;
  h.streak++;
  state.xp+=h.xp;
  state.totalDone++;
  const dow=(new Date().getDay()+6)%7;
  state.weekActivity[dow]=(state.weekActivity[dow]||0)+1;
  lastAction={type:'habit',id,xp:h.xp};
  saveState();
  checkAchievements();
  showToast('🎉 習慣達成！',`+${h.xp} XP 獲得！`);
  render();
}

function toggleTodo(id){
  const t=state.todos.find(x=>x.id===id);
  if(!t)return;
  const xpGain={high:30,med:20,low:10}[t.pri];
  t.done=!t.done;
  if(t.done){
    state.xp+=xpGain;state.totalDone++;
    const dow=(new Date().getDay()+6)%7;
    state.weekActivity[dow]=(state.weekActivity[dow]||0)+1;
    lastAction={type:'todo',id,xp:xpGain};
    showToast('✅ タスク完了！',`+${xpGain} XP 獲得！`,true);
    checkAchievements();
  } else {
    state.xp=Math.max(0,state.xp-xpGain);state.totalDone=Math.max(0,state.totalDone-1);
    const dow=(new Date().getDay()+6)%7;
    state.weekActivity[dow]=Math.max(0,(state.weekActivity[dow]||0)-1);
    showToast('↩ 取り消しました','タスクの完了を元に戻しました',false);
  }
  saveState();render();
}

function deleteHabit(id){state.habits=state.habits.filter(x=>x.id!==id);saveState();render();}
function deleteTodo(id){state.todos=state.todos.filter(x=>x.id!==id);saveState();render();}
function toggleReminder(i){state.reminders[i].on=!state.reminders[i].on;saveState();renderReminders();}

function checkAchievements(){
  let newUnlock=false;
  ACHIEVEMENTS.forEach(a=>{
    if(!state.unlockedAch.includes(a.id)&&a.cond(state)){
      state.unlockedAch.push(a.id);
      newUnlock=true;
      setTimeout(()=>showToast('🏆 実績解除！',a.name+' '+a.desc),800);
      if(state.unlockedAch.length>=2)launchConfetti();
    }
  });
  if(newUnlock){saveState();renderAch();}
}

// Modal
function openHabitModal(){
  const row=document.getElementById('emoji-row');
  row.innerHTML=EMOJIS.map(e=>`<div class="emoji-opt${e===selectedEmoji?' sel':''}" onclick="selectEmoji('${e}',this)">${e}</div>`).join('');
  document.getElementById('h-name').value='';
  document.getElementById('habit-modal').classList.add('open');
  setTimeout(()=>document.getElementById('h-name').focus(),200);
}
function selectEmoji(e,el){selectedEmoji=e;document.querySelectorAll('.emoji-opt').forEach(x=>x.classList.remove('sel'));el.classList.add('sel');}
function openTodoModal(){
  document.getElementById('t-name').value='';
  document.getElementById('todo-modal').classList.add('open');
  setTimeout(()=>document.getElementById('t-name').focus(),200);
}
function closeModal(id){document.getElementById(id).classList.remove('open');}

function addHabit(){
  const name=document.getElementById('h-name').value.trim();
  if(!name)return;
  state.habits.push({id:state.nextHabitId++,name,emoji:selectedEmoji,xp:+document.getElementById('h-diff').value,streak:0,lastDate:'',doneToday:false});
  saveState();render();closeModal('habit-modal');
}
function addTodo(){
  const name=document.getElementById('t-name').value.trim();
  if(!name)return;
  state.todos.push({id:state.nextTodoId++,name,pri:document.getElementById('t-pri').value,done:false});
  saveState();render();closeModal('todo-modal');
}

// Toast + Undo
let toastTimer,lastAction=null;
function showToast(title,msg,showUndo=false){
  clearTimeout(toastTimer);
  document.getElementById('toast-title').textContent=title;
  document.getElementById('toast-msg').textContent=msg;
  const btn=document.getElementById('toast-undo');
  btn.style.display=showUndo?'block':'none';
  const t=document.getElementById('toast');
  t.classList.add('show');
  toastTimer=setTimeout(()=>{t.classList.remove('show');lastAction=null;},showUndo?4000:2200);
}
function undoLast(){
  if(!lastAction)return;
  const act=lastAction;lastAction=null;
  clearTimeout(toastTimer);
  if(act.type==='habit'){
    const h=state.habits.find(x=>x.id===act.id);
    if(h&&h.doneToday){
      h.doneToday=false;h.lastDate='';h.streak=Math.max(0,h.streak-1);
      state.xp=Math.max(0,state.xp-act.xp);state.totalDone=Math.max(0,state.totalDone-1);
      const dow=(new Date().getDay()+6)%7;state.weekActivity[dow]=Math.max(0,(state.weekActivity[dow]||0)-1);
    }
  } else if(act.type==='todo'){
    const t2=state.todos.find(x=>x.id===act.id);
    if(t2&&t2.done){
      t2.done=false;state.xp=Math.max(0,state.xp-act.xp);state.totalDone=Math.max(0,state.totalDone-1);
      const dow=(new Date().getDay()+6)%7;state.weekActivity[dow]=Math.max(0,(state.weekActivity[dow]||0)-1);
    }
  }
  saveState();
  document.getElementById('toast').classList.remove('show');
  setTimeout(()=>showToast('↩ 取り消しました','元に戻しました',false),50);
  render();
}

// Confetti
function launchConfetti(){
  const canvas=document.getElementById('confetti-canvas');
  const ctx=canvas.getContext('2d');
  canvas.width=window.innerWidth;canvas.height=window.innerHeight;
  const pieces=Array.from({length:80},()=>({
    x:Math.random()*canvas.width,y:-10,
    vx:(Math.random()-0.5)*4,vy:Math.random()*4+2,
    color:['#7c6af7','#f5c842','#22d3a0','#a78bfa','#f87171'][Math.floor(Math.random()*5)],
    r:Math.random()*5+3,rot:Math.random()*360,vrot:(Math.random()-0.5)*10
  }));
  let frame;
  function draw(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    pieces.forEach(p=>{
      ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot*Math.PI/180);
      ctx.fillStyle=p.color;ctx.fillRect(-p.r,-p.r,p.r*2,p.r*2);ctx.restore();
      p.x+=p.vx;p.y+=p.vy;p.rot+=p.vrot;p.vy+=0.08;
    });
    if(pieces.some(p=>p.y<canvas.height))frame=requestAnimationFrame(draw);
    else ctx.clearRect(0,0,canvas.width,canvas.height);
  }
  draw();setTimeout(()=>{cancelAnimationFrame(frame);ctx.clearRect(0,0,canvas.width,canvas.height);},4000);
}


// ===== GITHUB SYNC =====
const GH_CFG_KEY='hq_gh_config';

function loadGhConfig(){
  const s=localStorage.getItem(GH_CFG_KEY);
  return s?JSON.parse(s):null;
}
function saveGhConfig(){
  const token=document.getElementById('gh-token').value.trim();
  const owner=document.getElementById('gh-owner').value.trim();
  const repo=document.getElementById('gh-repo').value.trim();
  const path=document.getElementById('gh-path').value.trim();
  if(!token||!owner||!repo||!path){setSyncStatus('err','すべての項目を入力してください');return;}
  const cfg={token,owner,repo,path};
  localStorage.setItem(GH_CFG_KEY,JSON.stringify(cfg));
  document.getElementById('sync-config').style.display='none';
  document.getElementById('sync-actions').style.display='block';
  setSyncStatus('ok',`${owner}/${repo} に接続済み`);
}
function clearGhConfig(){
  localStorage.removeItem(GH_CFG_KEY);
  document.getElementById('sync-config').style.display='block';
  document.getElementById('sync-actions').style.display='none';
  setSyncStatus('idle','未接続 — トークンを設定してください');
}
function setSyncStatus(type,msg){
  const dot=document.getElementById('sync-dot');
  dot.className='sync-dot '+type;
  document.getElementById('sync-msg').textContent=msg;
}
function setLastSync(label){
  const el=document.getElementById('sync-last');
  if(el)el.textContent='最終同期: '+new Date().toLocaleString('ja-JP',{month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'})+' ('+label+')';
}

async function ghApiGet(cfg){
  const url=`https://api.github.com/repos/${cfg.owner}/${cfg.repo}/contents/${encodeURIComponent(cfg.path)}`;
  const r=await fetch(url,{headers:{Authorization:`token ${cfg.token}`,'Accept':'application/vnd.github.v3+json'}});
  if(!r.ok)throw new Error(`GET ${r.status}: ${r.statusText}`);
  return r.json();
}
async function ghApiPut(cfg,content,sha){
  const url=`https://api.github.com/repos/${cfg.owner}/${cfg.repo}/contents/${encodeURIComponent(cfg.path)}`;
  const body={message:'HabitQuest sync '+new Date().toISOString(),content:btoa(unescape(encodeURIComponent(content)))};
  if(sha)body.sha=sha;
  const r=await fetch(url,{method:'PUT',headers:{Authorization:`token ${cfg.token}`,'Accept':'application/vnd.github.v3+json','Content-Type':'application/json'},body:JSON.stringify(body)});
  if(!r.ok){const e=await r.json();throw new Error(e.message||r.statusText);}
  return r.json();
}

async function ghPush(){
  const cfg=loadGhConfig();
  if(!cfg)return;
  const btn=document.getElementById('btn-push');
  btn.disabled=true;
  setSyncStatus('loading','GitHubに保存中...');
  try{
    let sha=null;
    try{const existing=await ghApiGet(cfg);sha=existing.sha;}catch(e){}
    // Build sync payload: only habits and todos (no XP/streak to avoid overwrite conflicts)
    const payload={habits:state.habits.map(h=>({id:h.id,name:h.name,emoji:h.emoji,xp:h.xp})),todos:state.todos.map(t=>({id:t.id,name:t.name,pri:t.pri,done:t.done})),syncedAt:new Date().toISOString(),source:'HabitQuest'};
    // Embed JSON in an HTML comment inside the existing file format
    const content=`<!-- HABITQUEST_SYNC:${JSON.stringify(payload)} -->`;
    await ghApiPut(cfg,content,sha);
    setSyncStatus('ok','✅ GitHubに保存しました');
    setLastSync('Push');
    showToast('☁ 同期完了','GitHubにデータを保存しました',false);
  }catch(e){
    setSyncStatus('err','エラー: '+e.message);
    showToast('⚠ 同期失敗',e.message,false);
  }finally{btn.disabled=false;}
}

async function ghPull(){
  const cfg=loadGhConfig();
  if(!cfg)return;
  const btn=document.getElementById('btn-pull');
  btn.disabled=true;
  setSyncStatus('loading','GitHubから読み込み中...');
  try{
    const file=await ghApiGet(cfg);
    const decoded=decodeURIComponent(escape(atob(file.content.replace(/\n/g,''))));
    const match=decoded.match(/<!--\s*HABITQUEST_SYNC:(.*?)\s*-->/s);
    if(!match)throw new Error('同期データが見つかりません。先にPushしてください。');
    const payload=JSON.parse(match[1]);
    // Merge: update habits list (preserve streaks/doneToday), merge todos
    const existingHabits=new Map(state.habits.map(h=>[h.id,h]));
    const mergedHabits=payload.habits.map(ph=>{
      const ex=existingHabits.get(ph.id);
      return ex?{...ex,name:ph.name,emoji:ph.emoji,xp:ph.xp}:{...ph,streak:0,lastDate:'',doneToday:false};
    });
    // Add local habits not in remote
    payload.habits.forEach(ph=>{if(!existingHabits.has(ph.id))mergedHabits.push({...ph,streak:0,lastDate:'',doneToday:false});});
    state.habits=mergedHabits;
    const existingTodos=new Map(state.todos.map(t=>[t.id,t]));
    state.todos=payload.todos.map(pt=>existingTodos.has(pt.id)?{...existingTodos.get(pt.id),...pt}:pt);
    state.nextHabitId=Math.max(state.nextHabitId,...state.habits.map(h=>h.id+1));
    state.nextTodoId=Math.max(state.nextTodoId,...state.todos.map(t=>t.id+1));
    saveState();render();
    setSyncStatus('ok','✅ GitHubから読み込みました');
    setLastSync('Pull');
    showToast('☁ 読み込み完了','GitHubのデータを取り込みました',false);
  }catch(e){
    setSyncStatus('err','エラー: '+e.message);
    showToast('⚠ 読み込み失敗',e.message,false);
  }finally{btn.disabled=false;}
}

function initSyncPanel(){
  const cfg=loadGhConfig();
  if(cfg){
    document.getElementById('gh-token').value=cfg.token;
    document.getElementById('gh-owner').value=cfg.owner;
    document.getElementById('gh-repo').value=cfg.repo;
    document.getElementById('gh-path').value=cfg.path;
    document.getElementById('sync-config').style.display='none';
    document.getElementById('sync-actions').style.display='block';
    setSyncStatus('ok',`${cfg.owner}/${cfg.repo} に接続済み`);
  }
}
initSyncPanel();
// ===== END GITHUB SYNC =====

// Close modal on bg click
document.querySelectorAll('.modal-bg').forEach(bg=>bg.addEventListener('click',e=>{if(e.target===bg)bg.classList.remove('open')}));

render();
</script>
